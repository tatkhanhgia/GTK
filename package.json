{
  "name": "gtkblog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --env-file-if-exists=.env.local scripts/bootstrap-db.js",
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebuild": "tsx --require ./src/scripts/patch-next-env.cjs scripts/generate-admin-translations.ts",
    "seed": "tsx --require ./src/scripts/patch-next-env.cjs src/scripts/seed.ts",
    "db:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-db.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@payloadcms/db-postgres": "^3.81.0",
