{
  "name": "gtkblog",
  "version": "0.1.10",
  "private": true,
  "scripts": {
    "predev": "node scripts/bootstrap-db.js",
    "dev": "cross-env PAYLOAD_MIGRATING=true next dev",
    "build": "cross-env PAYLOAD_MIGRATING=true NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebuild": "tsx --require ./src/scripts/patch-next-env.cjs scripts/generate-admin-translations.ts",
    "seed": "tsx --require ./src/scripts/patch-next-env.cjs src/scripts/seed.ts",
    "db:bootstrap": "node scripts/bootstrap-db.js",
    "db:deploy": "tsx --require ./src/scripts/patch-next-env.cjs scripts/payload-db-sync.ts && node scripts/bootstrap-db.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@react-email/components": "^1.0.11",
    "@stripe/stripe-js": "^9.0.1",
    "@upstash/ratelimit": "^2.0.8",
    "better-auth": "1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "payload": "3.84.1",
    "postgres": "^3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^5.2.10",
    "resend": "^6.10.0",
    "shadcn": "^4.1.2",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.8.9",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "postcss": "8.5.14",
    "uuid": "11.1.1",
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "@hono/node-server": "1.19.13",
    "express-rate-limit": "8.5.2",
    "ip-address": "10.2.0"
  }
}
