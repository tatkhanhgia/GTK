# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gtkblog
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/gtkblog_test
TEST_DATABASE_NAME=gtkblog_test
# DB_CHECK_MAINTENANCE_DATABASE=postgres

# Payload CMS
PAYLOAD_SECRET=your-secret-key-min-32-chars

# Auth - Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth - GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth - Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SePay
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=

# Email - provider-neutral settings
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
ZOHO_ZEPTOMAIL_TOKEN=
ZOHO_ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_URL=https://api.cloudflare.com/client/v4
EMAIL_SETTINGS_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret

# Admin AI - provider API keys are stored encrypted in Payload, not in frontend env
ADMIN_AI_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
